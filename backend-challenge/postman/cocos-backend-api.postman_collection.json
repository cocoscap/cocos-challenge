{
  "info": {
    "name": "Cocos Challenge - Backend API",
    "description": "Pedidos de ejemplo para la API del challenge de backend de Cocos. La variable baseUrl apunta a http://localhost:3000.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    }
  ],
  "item": [
    {
      "name": "Portfolio",
      "item": [
        {
          "name": "Portfolio de un usuario",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/users/1/portfolio"
          }
        },
        {
          "name": "Portfolio de un usuario sin movimientos",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/users/2/portfolio"
          }
        },
        {
          "name": "Usuario inexistente (404 USER_NOT_FOUND)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/users/999999/portfolio"
          }
        },
        {
          "name": "Id inválido (400 VALIDATION_ERROR)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/users/abc/portfolio"
          }
        }
      ]
    },
    {
      "name": "Búsqueda de activos",
      "item": [
        {
          "name": "Buscar por ticker",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/instruments?q=PAMP"
          }
        },
        {
          "name": "Buscar por nombre",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/instruments?q=molinos"
          }
        },
        {
          "name": "Buscar sin acentos ni eñe",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/instruments?q=compania"
          }
        },
        {
          "name": "Ticker exacto primero",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/instruments?q=MOLI"
          }
        },
        {
          "name": "Limitar la cantidad de resultados",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/instruments?q=s.a.&limit=5"
          }
        },
        {
          "name": "Activo sin precios",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/instruments?q=PGR"
          }
        },
        {
          "name": "Sin coincidencias (200 con lista vacía)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/instruments?q=zzzzzz"
          }
        },
        {
          "name": "Sin texto de búsqueda (400 VALIDATION_ERROR)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/instruments"
          }
        },
        {
          "name": "Límite fuera de rango (400 VALIDATION_ERROR)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/instruments?q=pamp&limit=101"
          }
        }
      ]
    }
  ]
}
